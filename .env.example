# =============================================================================
# Event-Driven Transactional Email Notification Service Configuration
# =============================================================================

# Application Environment
ENV=development
LOG_LEVEL=INFO

# API Service Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@database:5432/notification_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notification_db
DB_HOST=database
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis Cache TTLs (in seconds)
TEMPLATE_CACHE_TTL=3600
USER_PREFS_CACHE_TTL=3600

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=email_notifications
RABBITMQ_EXCHANGE=email_notifications_exchange
RABBITMQ_ROUTING_KEY=email.notification.send
RABBITMQ_PREFETCH_COUNT=10
